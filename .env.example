# Copy to .env and fill in. Never commit .env.

# Public domain Caddy gets a TLS certificate for.
ATRIUM_DOMAIN=chat.example.com
POSTGRES_PASSWORD=change-me
# Only when Caddy doesn't listen on 80/443 directly (e.g. behind another proxy):
# HTTP_PORT=8080
# HTTPS_PORT=8443
# ATRIUM_PUBLIC_URL=https://chat.example.com:8443
# ATRIUM_PUBLIC_WS=wss://chat.example.com:8443

# Language model. anthropic (default) or openai_compat for a self hosted model.
ATRIUM_LLM_PROVIDER=anthropic
ATRIUM_LLM_MODEL=claude-sonnet-5-5
ATRIUM_ANTHROPIC_API_KEY=
# Self hosted, OpenAI compatible (vLLM, Ollama, llama.cpp server):
# ATRIUM_LLM_PROVIDER=openai_compat
# ATRIUM_OPENAI_COMPAT_BASE_URL=http://ollama:11434/v1
# ATRIUM_OPENAI_COMPAT_MODEL=qwen3.6:35b-a3b
# ATRIUM_OPENAI_COMPAT_API_KEY=
# ATRIUM_OPENAI_COMPAT_REASONING=none

# Voice in rooms (LiveKit). Make up a key and a long random secret.
ATRIUM_LIVEKIT_API_KEY=atrium
ATRIUM_LIVEKIT_API_SECRET=change-me-to-at-least-32-random-characters

# Room notes: faster-whisper model (tiny, base, small, medium, large-v3), runs on the CPU.
ATRIUM_WHISPER_MODEL=small
ATRIUM_WHISPER_LANGUAGE=
# Build without notes support to keep the image small:
# WITH_NOTES=0

# Guest links are valid this many days unless set when inviting.
ATRIUM_GUEST_LINK_DAYS=90
ATRIUM_MAX_UPLOAD_MB=20
